NEXT_PUBLIC_WEBSITE_URL=http://localhost:3009
# Analytics, loaded in production only
NEXT_PUBLIC_GOOGLETAG=          # Google Tag Manager id, GTM-XXXXXXX
NEXT_PUBLIC_MICROSOFT_CLARITY=  # Clarity project id

# Neon Postgres (pooled connection string)
POSTGRES_URL=

# Signs admin session cookies. openssl rand -hex 32
AUTH_SECRET=

# Admin username + password live in the database (table: admins).
# Create or reset: npm run admin:create -- <username> <password>
